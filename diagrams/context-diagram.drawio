<mxfile host="app.diagrams.net"><diagram name="MedGuard: System Context Diagram"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1180"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MedGuard: System Context Diagram" style="text;html=1;fontSize=30;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell><mxCell id="PAT" value="&lt;b style=&quot;font-size:21px&quot;&gt;Patient&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Keeps own history, books visits, follows the schedule&lt;/font&gt;" style="html=1;whiteSpace=wrap;shape=mxgraph.c4.person2;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;labelPosition=center;verticalAlign=middle;spacingTop=50;" vertex="1" parent="1"><mxGeometry x="180.0" y="120" width="300" height="190" as="geometry"/></mxCell><mxCell id="DOC" value="&lt;b style=&quot;font-size:21px&quot;&gt;Doctor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Clinic doctor of any specialty&lt;/font&gt;" style="html=1;whiteSpace=wrap;shape=mxgraph.c4.person2;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;labelPosition=center;verticalAlign=middle;spacingTop=50;" vertex="1" parent="1"><mxGeometry x="750.0" y="120" width="300" height="190" as="geometry"/></mxCell><mxCell id="ADM" value="&lt;b style=&quot;font-size:21px&quot;&gt;Administrator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Observes usage; no access to personal data&lt;/font&gt;" style="html=1;whiteSpace=wrap;shape=mxgraph.c4.person2;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;labelPosition=center;verticalAlign=middle;spacingTop=50;" vertex="1" parent="1"><mxGeometry x="1320.0" y="120" width="300" height="190" as="geometry"/></mxCell><mxCell id="SYS" value="&lt;b style=&quot;font-size:21px&quot;&gt;MedGuard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Web application: patient history, appointment booking, medication safety check with sources, intake schedule and reminders&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="600" y="500" width="600" height="210" as="geometry"/></mxCell><mxCell id="TG" value="&lt;b style=&quot;font-size:21px&quot;&gt;Telegram Bot API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[External system]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Delivers reminders, questionnaire and bot replies&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8C96A3;strokeColor=#6B7480;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="180" y="520" width="300" height="170" as="geometry"/></mxCell><mxCell id="RX" value="&lt;b style=&quot;font-size:21px&quot;&gt;RxNorm / RxNav&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[NLM API]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Standard drug names and ingredients&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8C96A3;strokeColor=#6B7480;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="105.0" y="930" width="330" height="150" as="geometry"/></mxCell><mxCell id="FDA" value="&lt;b style=&quot;font-size:21px&quot;&gt;openFDA Drug Label&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[FDA API]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Contraindications, warnings, interactions&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8C96A3;strokeColor=#6B7480;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="515.0" y="930" width="330" height="150" as="geometry"/></mxCell><mxCell id="DM" value="&lt;b style=&quot;font-size:21px&quot;&gt;DailyMed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[NLM]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Official label (SPL) text&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8C96A3;strokeColor=#6B7480;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="925.0" y="930" width="330" height="150" as="geometry"/></mxCell><mxCell id="DDI" value="&lt;b style=&quot;font-size:21px&quot;&gt;DDInter 2.0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Open DDI database]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Interaction, drug–disease, duplication records&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8C96A3;strokeColor=#6B7480;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1335.0" y="930" width="330" height="150" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeColor=#5A6472;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="310" as="sourcePoint"/><mxPoint x="700" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="&lt;b&gt;Creates profile, writes own&lt;br&gt;history, books appointments&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6472&quot; style=&quot;font-size:14px&quot;&gt;[HTTPS]&lt;/font&gt;" style="text;html=1;fontSize=16;align=center;fontColor=#2E3A48;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="360.0" y="359.0" width="260" height="66" as="geometry"/></mxCell><mxCell id="e3" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeColor=#5A6472;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="310" as="sourcePoint"/><mxPoint x="900" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="&lt;b&gt;Publishes free slots, reviews history,&lt;br&gt;checks prescriptions, approves schedules&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6472&quot; style=&quot;font-size:14px&quot;&gt;[HTTPS]&lt;/font&gt;" style="text;html=1;fontSize=16;align=center;fontColor=#2E3A48;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="770.0" y="365.0" width="260" height="66" as="geometry"/></mxCell><mxCell id="e5" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeColor=#5A6472;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1470" y="310" as="sourcePoint"/><mxPoint x="1100" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e6" value="&lt;b&gt;Views clinics, doctors, login&lt;br&gt;and event journals&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6472&quot; style=&quot;font-size:14px&quot;&gt;[HTTPS]&lt;/font&gt;" style="text;html=1;fontSize=16;align=center;fontColor=#2E3A48;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1250.0" y="359.0" width="260" height="66" as="geometry"/></mxCell><mxCell id="e7" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeColor=#5A6472;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="605" as="sourcePoint"/><mxPoint x="480" y="605" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e8" value="&lt;b&gt;Sends&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6472&quot; style=&quot;font-size:14px&quot;&gt;[Bot API]&lt;/font&gt;" style="text;html=1;fontSize=16;align=center;fontColor=#2E3A48;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="410.0" y="540.0" width="260" height="46" as="geometry"/></mxCell><mxCell id="e9" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeColor=#5A6472;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="520" as="sourcePoint"/><mxPoint x="330" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e10" value="&lt;b&gt;Reminders,&lt;br&gt;questionnaire, chat&lt;/b&gt;" style="text;html=1;fontSize=16;align=right;fontColor=#2E3A48;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="56.0" y="384.0" width="260" height="46" as="geometry"/></mxCell><mxCell id="e11" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeColor=#5A6472;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="710" as="sourcePoint"/><mxPoint x="270" y="930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e12" value="&lt;b&gt;Normalises drug names&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6472&quot; style=&quot;font-size:14px&quot;&gt;[REST / JSON, cached]&lt;/font&gt;" style="text;html=1;fontSize=16;align=center;fontColor=#2E3A48;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="273.5" y="800.0" width="260" height="46" as="geometry"/></mxCell><mxCell id="e13" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeColor=#5A6472;strokeWidth=2.2;dashed=1;dashPattern=9 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="710" as="sourcePoint"/><mxPoint x="680" y="930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e14" value="&lt;b&gt;Label sections&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6472&quot; style=&quot;font-size:14px&quot;&gt;[loaded by team scripts]&lt;/font&gt;" style="text;html=1;fontSize=16;align=center;fontColor=#2E3A48;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="593.0" y="800.0" width="260" height="46" as="geometry"/></mxCell><mxCell id="e15" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeColor=#5A6472;strokeWidth=2.2;dashed=1;dashPattern=9 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="710" as="sourcePoint"/><mxPoint x="1090" y="930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e16" value="&lt;b&gt;Label text&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6472&quot; style=&quot;font-size:14px&quot;&gt;[loaded by team scripts]&lt;/font&gt;" style="text;html=1;fontSize=16;align=center;fontColor=#2E3A48;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="940.5" y="800.0" width="260" height="46" as="geometry"/></mxCell><mxCell id="e17" style="endArrow=block;endFill=1;endSize=10;html=1;rounded=0;strokeColor=#5A6472;strokeWidth=2.2;dashed=1;dashPattern=9 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="710" as="sourcePoint"/><mxPoint x="1500" y="930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="&lt;b&gt;Rule-base data&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6472&quot; style=&quot;font-size:14px&quot;&gt;[loaded by team scripts]&lt;/font&gt;" style="text;html=1;fontSize=16;align=center;fontColor=#2E3A48;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1250.0" y="800.0" width="260" height="46" as="geometry"/></mxCell><mxCell id="e19" value="&lt;b&gt;Legend:&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;fontColor=#0B2239;" vertex="1" parent="1"><mxGeometry x="40" y="1124" width="300" height="26" as="geometry"/></mxCell><mxCell id="e20" style="rounded=1;strokeColor=#073B6F;fillColor=#08427B;" vertex="1" parent="1"><mxGeometry x="130" y="1128" width="28" height="20" as="geometry"/></mxCell><mxCell id="e21" value="Person" style="text;html=1;fontSize=17;align=left;fontColor=#2E3A48;" vertex="1" parent="1"><mxGeometry x="166" y="1124" width="300" height="26" as="geometry"/></mxCell><mxCell id="e22" style="rounded=1;strokeColor=#0B4884;fillColor=#1168BD;" vertex="1" parent="1"><mxGeometry x="400" y="1128" width="28" height="20" as="geometry"/></mxCell><mxCell id="e23" value="Syste