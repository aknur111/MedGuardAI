1"><mxGeometry x="100" y="315" width="1680" height="80" as="geometry"/></mxCell><mxCell id="PH" value="&lt;b style=&quot;font-size:21px&quot;&gt;Profile &amp;amp; History&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Profile, own history, source labels&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="74.0" y="440" width="272" height="120" as="geometry"/></mxCell><mxCell id="BOOK" value="&lt;b style=&quot;font-size:21px&quot;&gt;Scheduling &amp;amp; Booking&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Free slots, bookings, cancellations&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="364.0" y="440" width="272" height="120" as="geometry"/></mxCell><mxCell id="VIS" value="&lt;b style=&quot;font-size:21px&quot;&gt;Visit &amp;amp; Prescription&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Visit notes, proposed medicines&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="654.0" y="440" width="272" height="120" as="geometry"/></mxCell><mxCell id="CLD" value="&lt;b style=&quot;font-size:21px&quot;&gt;Clinic Directory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Clinics, doctors, specialties&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="944.0" y="440" width="272" height="120" as="geometry"/></mxCell><mxCell id="LOG" value="&lt;b style=&quot;font-size:21px&quot;&gt;Usage &amp;amp; Log Reader&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Counts and journals, pseudonymised&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1234.0" y="440" width="272" height="120" as="geometry"/></mxCell><mxCell id="AUD" value="&lt;b style=&quot;font-size:21px&quot;&gt;Audit Logger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Logins, bookings, checks, decisions&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1524.0" y="440" width="272" height="120" as="geometry"/></mxCell><mxCell id="SCH" value="&lt;b style=&quot;font-size:21px&quot;&gt;Schedule Generator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Constraint-based dose times&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="364.0" y="635" width="272" height="120" as="geometry"/></mxCell><mxCell id="DSE" value="&lt;b style=&quot;font-size:21px&quot;&gt;Drug Safety Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Interaction · allergy · disease · duplicate · dose&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="654.0" y="635" width="272" height="120" as="geometry"/></mxCell><mxCell id="NORM" value="&lt;b style=&quot;font-size:21px&quot;&gt;Medication Normalizer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Brand / generic → ingredient&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="944.0" y="635" width="272" height="120" as="geometry"/></mxCell><mxCell id="NLP" value="&lt;b style=&quot;font-size:21px&quot;&gt;NLP Anamnesis Parser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Free text → structured entities&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="74.0" y="965" width="272" height="120" as="geometry"/></mxCell><mxCell id="LLM" value="&lt;b style=&quot;font-size:21px&quot;&gt;Local LLM Runtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component: Ollama / vLLM]&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="364.0" y="965" width="272" height="120" as="geometry"/></mxCell><mxCell id="EXP" value="&lt;b style=&quot;font-size:21px&quot;&gt;Explanation Generator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;+ evidence support check&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="654.0" y="965" width="272" height="120" as="geometry"/></mxCell><mxCell id="RAG" value="&lt;b style=&quot;font-size:21px&quot;&gt;Evidence Retriever&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component: RAG]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Label passages, pgvector&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="944.0" y="965" width="272" height="120" as="geometry"/></mxCell><mxCell id="WRK" value="&lt;b style=&quot;font-size:21px&quot;&gt;Reminder Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component: Celery beat]&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="364.0" y="1330" width="272" height="120" as="geometry"/></mxCell><mxCell id="BOT" value="&lt;b style=&quot;font-size:21px&quot;&gt;Telegram Bot Adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Reminders, questionnaire, chat&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="654.0" y="1330" width="272" height="120" as="geometry"/></mxCell><mxCell id="GEN" value="&lt;b style=&quot;font-size:21px&quot;&gt;Synthetic Data Generator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Script]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Patients, clinics, doctors (seed)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#0B2239;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="944.0"