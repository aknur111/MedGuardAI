<mxfile host="app.diagrams.net"><diagram name="Component Diagram (draft) — MedGuard"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2170" pageHeight="2060"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Component Diagram (draft) — MedGuard" style="text;html=1;fontSize=30;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;API Application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Container: Python, FastAPI]&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=10 6;fillColor=none;strokeColor=#7A8594;strokeWidth=2;verticalAlign=bottom;align=right;spacingLeft=14;spacingRight=14;spacingBottom=8;spacingTop=6;fontSize=19;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="285" width="1740" height="610" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;AI Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Container: Python, local model]&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=10 6;fillColor=none;strokeColor=#7A8594;strokeWidth=2;verticalAlign=bottom;align=right;spacingLeft=14;spacingRight=14;spacingBottom=8;spacingTop=6;fontSize=19;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="935" width="1160" height="245" as="geometry"/></mxCell><mxCell id="e3" value="&lt;b&gt;Background Workers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Container: Python, Celery]&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=10 6;fillColor=none;strokeColor=#7A8594;strokeWidth=2;verticalAlign=top;align=right;spacingLeft=14;spacingRight=14;spacingBottom=8;spacingTop=6;fontSize=19;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="1250" width="870" height="250" as="geometry"/></mxCell><mxCell id="e4" value="&lt;b&gt;Offline Data Preparation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;[Team scripts, run before deployment]&l